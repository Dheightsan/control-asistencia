# Valores de prueba. Copia a .env si quieres cambiarlos.
# Si DATABASE_URL no existe, `npm run db` levanta un postgres embebido en este puerto.
DATABASE_URL=postgres://asistencia:asistencia@localhost:54329/asistencia
API_PORT=3001
# Origen del web, para CORS
WEB_ORIGIN=http://localhost:3000
# La lee el web al compilar
NEXT_PUBLIC_API_URL=http://localhost:3001
